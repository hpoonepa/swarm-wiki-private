---
import type { ReactNode } from "react";
import Nav from "../components/Nav";
import "../styles/fonts.css";
import "../styles/global.css";

export interface Props {
  title: string;
  children: ReactNode;
}

import Footer from "../components/Footer";

const { title } = Astro.props;
// const { openNavBar } = false;
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="https://static.igem.wiki/teams/5612/mainlayout/fabicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link
      href="../components/fonts.css"
      rel="stylesheet"
    /> -->
    <title>{title}</title>
  </head>
  <body class="bg-[#FFFCF3] overscroll-y-none">
    <div class="w-full flex flex-col h-full items-center overflow-hidden">
      <!-- <div class="w-full mt-8"> -->
      <!-- <div class="w-full flex justify-center items-center sticky top-0"> -->
      <div
        class="w-full flex justify-between items-center m-5 z-50 max-w-6xl grow top-5 absolute"
      >
        <Nav client:only="react" className="z-50" />
      </div>

      <slot />
    </div>
  </body>
</html>
