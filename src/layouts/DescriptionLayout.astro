---
import ContentLayout from './ContentLayout.astro';
const { frontmatter, headings } = Astro.props;
---

<ContentLayout frontmatter={frontmatter} headings={headings}>
  <slot />
</ContentLayout>

<style is:global>
  /* This layout is used only by Project Description. One grid gap replaces
     stacked paragraph, heading, and table margins. */
  #article.info-prose {
    --description-block-gap: 1.25rem;
    --description-section-gap: clamp(2.5rem, 5vw, 3.5rem);
    row-gap: var(--description-block-gap);
  }

  #article.info-prose > * { margin-block: 0; }

  #article.info-prose > h1:not(:first-child),
  #article.info-prose > .description-references {
    margin-block-start: calc(var(--description-section-gap) - var(--description-block-gap));
  }

  #article .description-references {
    border-block: 1px solid #1a322a24;
    padding-block: 1rem;
  }

  #article .description-references > summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  #article .description-references > summary::-webkit-details-marker { display: none; }

  #article .description-references > summary::before {
    content: '';
    flex: none;
    width: .65rem;
    height: .65rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    color: var(--maroon);
    transform: rotate(-45deg);
  }

  #article .description-references[open] > summary::before { transform: rotate(45deg); }
  #article .description-references > summary > h1 { margin: 0; }
  #article .description-references[open] > summary { margin-block-end: 1.5rem; }
  #article .description-references > p { margin-block: 0 1.25rem; scroll-margin-top: 110px; }
  #article .description-references > p:last-child { margin-block-end: 0; }
</style>

<script>
  const references = document.querySelector<HTMLDetailsElement>('.description-references');

  function revealReference(hash: string, scroll = false) {
    if (!hash.startsWith('#reference-')) return;
    const target = document.getElementById(hash.slice(1));
    if (!references || !target || !references.contains(target)) return;
    references.open = true;
    if (scroll) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }

  // Expand before the browser follows the citation, including a repeated click
  // on the current fragment after the reader has collapsed the list.
  document.addEventListener('click', event => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>('a[href^="#reference-"]')
      : null;
    if (link) revealReference(link.hash);
  });

  addEventListener('hashchange', () => revealReference(location.hash, true));
  revealReference(location.hash, true);
</script>
