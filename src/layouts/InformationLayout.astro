---
import type { MarkdownHeading } from 'astro';
import Nav from '../components/Nav';
import Footer from '../components/Footer';
import TabReact from '../components/md_components/TabReact';
import CanopyWindow from '../components/info/CanopyWindow.astro';
import HoneycombWindow, { type HoneycombCorner } from '../components/info/HoneycombWindow.astro';
import SideMap from '../components/info/SideMap.astro';
import SectionSheet from '../components/info/SectionSheet.astro';
import SdgWheel from '../components/info/SdgWheel.astro';
import { readingPage } from '../components/info/pages';
import type { Section } from '../components/info/sidemap';
import '../styles/global.css';
import '../components/info/reading.css';

interface Props {
  frontmatter: { title: string; description?: string; summary?: string[]; noTOC?: boolean; tabLabels?: string[]; tabLinks?: string[]; color?: string; hero?: 'honeycomb' | 'canopy'; honeycombCorner?: HoneycombCorner; band?: 'sdg' };
  headings?: MarkdownHeading[];
}
const { frontmatter, headings = [] } = Astro.props;
const summary = frontmatter.summary ?? [];
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
const page = readingPage(slug);
const hero = frontmatter.hero ?? 'honeycomb';
const topDepth = headings.some(heading => heading.depth === 1) ? 1 : 2;
const sections: Section[] = frontmatter.noTOC ? [] : headings
  .filter(heading => heading.depth === topDepth || heading.depth === topDepth + 1)
  .map(heading => ({ id: heading.slug, text: heading.text, depth: (heading.depth - topDepth + 2) as 2 | 3 }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="https://static.igem.wiki/teams/6185/wiki/lastmin/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="https://static.igem.wiki/teams/6185/wiki/lastmin/favicon-32.avif" type="image/avif" sizes="32x32" />
    <link rel="apple-touch-icon" href="https://static.igem.wiki/teams/6185/wiki/lastmin/apple-touch-icon.avif" />
    <title>{`Lambert-GA | ${frontmatter.title}`}</title>
    {frontmatter.description && <meta name="description" content={frontmatter.description} />}
  </head>
  <body class="info-page">
    <script is:inline src="/lambert-ga/home/cursor.js?v=d226b130b92d"></script>
    <a class="info-skip" href="#article">Skip to content</a>
    <Nav client:load />
    <main class:list={[{ 'plain-page': sections.length === 0 }]} data-band={frontmatter.band}>
      <slot name="hero">{hero === 'honeycomb'
        ? <HoneycombWindow title={frontmatter.title} corner={frontmatter.honeycombCorner} />
        : <CanopyWindow title={frontmatter.title} group={page.group} focal={page.focal} />}</slot>
      {frontmatter.band === 'sdg' && <SdgWheel />}
      <div class:list={['sheet', { 'sheet--summary': summary.length > 0 }]} data-surface="sheet">
        {frontmatter.tabLabels && frontmatter.tabLinks && <div class="info-tabs"><TabReact labels={frontmatter.tabLabels} links={frontmatter.tabLinks} focus={slug} color={frontmatter.color ?? 'green'} /></div>}
        {summary.length > 0 && <section class="reading-summary" aria-label="Summary">
          <p class="reading-summary__label">Summary</p>
          {/* Summary paragraphs are trusted, repository-authored frontmatter. */}
          {summary.map(paragraph => <p set:html={paragraph} />)}
        </section>}
        <div class:list={['longform', { 'longform--no-map': sections.length === 0 }]}>
          {sections.length > 0 && <div class="longform__map"><SideMap sections={sections} /></div>}
          <div class="longform__main">
            {sections.length > 0 && <SectionSheet sections={sections} />}
            <article id="article" class="info-prose flow content" tabindex="-1">
              <slot />
            </article>
            <div class="longform__end" data-longform-end aria-hidden="true"></div>
            {(page.prev || page.next) && <nav class="continue" aria-label="Continue reading">
              {page.prev && <a class="continue__card" href={page.prev.href} rel="prev"><span class="eyebrow continue__dir">← Previous</span><span class="continue__title">{page.prev.title}</span></a>}
              {page.next && <a class="continue__card" href={page.next.href} rel="next"><span class="eyebrow continue__dir">Continue</span><span class="continue__title">{page.next.title} →</span></a>}
            </nav>}
          </div>
        </div>
      </div>
    </main>
    <div class="info-footer">
      <div class="overflow-hidden w-full relative flex justify-center"><Footer /></div>
    </div>
    <script>
      document.querySelectorAll<HTMLTableElement>('.info-prose > table').forEach((table, index) => {
        let previous = table.previousElementSibling;
        while (previous && !/^H[1-6]$/.test(previous.tagName)) previous = previous.previousElementSibling;
        const wrapper = document.createElement('div');
        wrapper.className = 'reading-table';
        wrapper.setAttribute('role', 'region');
        wrapper.setAttribute('aria-label', `${previous?.textContent?.trim() || 'Article'} — table ${index + 1}`);
        wrapper.style.setProperty('--table-columns', String(table.rows[0]?.cells.length || 1));
        table.querySelectorAll('thead th').forEach(heading => heading.setAttribute('scope', 'col'));
        table.before(wrapper);
        wrapper.append(table);
        const update = () => { wrapper.tabIndex = wrapper.scrollWidth > wrapper.clientWidth + 1 ? 0 : -1; };
        new ResizeObserver(update).observe(wrapper);
        update();
      });
    </script>
  </body>
</html>

<style>
  /* Keep the hero decoration behind the full-width summary. */
  .sheet--summary { z-index: 2; }

  .reading-summary {
    display: grid;
    gap: 1rem;
    width: min(78rem, calc(100% - 2 * var(--gutter)));
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid #e5b14470;
    border-radius: var(--r-card);
    background: #fffaf0;
    overflow-wrap: anywhere;
  }

  .reading-summary > p { margin: 0; }
  .reading-summary__label {
    color: var(--moss);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
</style>
