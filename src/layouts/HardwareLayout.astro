---
import InformationLayout from './InformationLayout.astro';
import HoneycombWindow from '../components/info/HoneycombWindow.astro';
import VaporExplorer from '../components/hardware/VaporExplorer.astro';
const { frontmatter, headings } = Astro.props;
---
<InformationLayout frontmatter={frontmatter} headings={headings}>
  <HoneycombWindow slot="hero" title={frontmatter.title} summary={frontmatter.description} corner={frontmatter.honeycombCorner}>
    <VaporExplorer slot="figure" />
  </HoneycombWindow>
  <slot />
</InformationLayout>
