---
import type { MarkdownHeading } from "astro";
import PageLayout from "./PageLayout.tsx";
import Footer from "../components/Footer";
import TabReact from "../components/md_components/TabReact";
import "../styles/global.css";
import FooterNav from "../components/footernav";
import type { string } from "astro:schema";

const { frontmatter, headings } = Astro.props;
const { isTab, isDark, tabLabels, tabLinks, noTOC } = frontmatter;
const currentPageSlug =
  Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
const h1Headings = headings.filter(
  (heading: MarkdownHeading) => heading.depth === 1 || heading.depth === 2
);
---

<!doctype html>
<html lang="en" class:list={["font-sans", { dark: isTab || isDark }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="https://static.igem.wiki/teams/5612/mainlayout/fabicon.webp"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{"Lambert-GA | " + frontmatter.title}</title>
  </head>
  <body>
    <PageLayout
      client:load
      {...frontmatter}
      headings={h1Headings}
      noTOC={noTOC}
      isTab={isTab}
      TOCPadding={!!tabLabels}
    >
      <slot />
      <Fragment slot="tabs">
        {
          tabLabels && tabLinks && (
            <TabReact
              labels={tabLabels}
              links={tabLinks}
              focus={currentPageSlug}
              color={frontmatter.color}
              client:load
            />
          )
        }
      </Fragment>
    </PageLayout>
    <div class="hidden md:block">
      <FooterNav />
      </div>
    <div class="overflow-hidden w-full relative flex justify-center overflow-hidden bg-[#FFFCF3">
      <Footer />
    </div>
  </body>
  <style is:global>
    h1 {
      font-size: 20px;
    }

    .toc {
      overflow-y: auto;
      max-height: 80vh;
      background-color: #f8efe2;
      padding-bottom: 20px;
      border-radius: 0px 0px 20px 20px;
    }

    .content .table-container {
      max-width: 80%;
      align-items: center;
      text-align: center;
      display: flex;
      margin-inline: auto;
      justify-content: center;
    }
    .content table {
      width: 100%;
      table-layout: fixed; /* Forces equal-width columns */
      border-collapse: collapse;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .content table td,
    .content table th {
      word-break: break-word;
      white-space: normal;
      text-align: center;
      padding: 8px;
    }

    .toc-container {
      flex-direction: column;
      margin-left: 20px;
      max-width: 300px;
      min-width: 250px;
      position: sticky;
      width: 20%;
      font-size: 18px;
      top: 5%;
    }

    .toc-heading {
      font-family: "Inter", sans-serif;
      text-align: center;
      font-weight: bold;
      background-color: #cfe6b2;
      font-size: 24px;
      padding-top: 19px;
      padding-bottom: 10px;
      border-bottom: 8px solid #447700; /* width | style | color */
      border-radius: 20px 20px 0px 0px;
      margin-top: -3px;
    }

    .toch2 {
      font-size: 16px;
    }

    .content h1 {
      margin-top: -3px;
      text-align: center;
      font-size: 36px;
      padding-top: 12px;
      padding-bottom: 12px;
      border-bottom: 8px solid #447700;
      border-radius: 20px 20px 0px 0px;
    }

    .content h2 {
      padding: 20px;
      font-size: 28px;
    }

    .content h3 {
      padding-left: 20px;
      font-size: 24px;
    }

    .content h4 {
      padding-left: 20px;
    }

    .content h1(:first-of-type) {
      margin-top: 100px;
    }

    .content p {
      padding-inline: 20px;
      font-size: 18px;
    }

    .content {
      margin-inline: 20px;
    }

    .content-wrapper {
      display: flex;
      flex-direction: column;
      margin-bottom: 20%;

      margin-left: 0px;
    }

    .content *:not(h1) {
    }

    .content a {
      color: #447700;
    }

    .content ul li::marker {
      color: #000;
    }

    .katex-html {
      display: none;
    }

    .horiz {
      display: flex;
    }

    .tabs {
      height: 100px;
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .horiz {
      display: flex;
    }
    @media screen and (max-width: 1020px) {
      .horiz {
        display: block;
      }
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none; /* IE and Edge */
      scrollbar-width: none; /* Firefox */
    }

    @media screen and (max-width: 640px) {
      .table-container {
        width: 90vw;
        display: flex;
        overflow-x: auto; /* Adds a horizontal scrollbar if the table is too wide */
        -webkit-overflow-scrolling: touch; /* Improves scrolling on iOS */
        border-radius: 8px; /* Optional: adds nice rounded corners */
        border: 1px solid #ddd; /* Optional: visually contains the table */
      }

      iframe {
        display: block;
        margin: 0 auto;

        max-width: 50%;
      }

      .tabs {
        display: block;

        justify-content: center;
        margin-bottom: 35vh;
      }
    }

    iframe {
      display: block;
      margin: 0 auto;
      width: 80%;
      max-width: 100%;
      height: 50vh;
    }
    .seperator {
      height: 3px;
      margin-inline: 100px;
      margin-bottom: 30px;

      background-color: #b1aa9c;
    }

    .seperator {
      height: 3px;
      margin-inline: 100px;
      margin-bottom: 30px;
      background-color: #b1aa9c;
    }

    .math-table-container {
      /* This creates a centered block that is, at most, 80% of its parent's width. */
      max-width: 80%;
      display:;
      margin: 1rem auto; /* Centers the block and adds vertical space */
      /* This adds the horizontal scrollbar if the table inside is wider than the container. */
      overflow-x: auto;
      /* Improves scrolling momentum on touch devices */
      -webkit-overflow-scrolling: touch;
    }

    ./* --- This is the key change --- */
.math-table-container th:first-child,
.math-table-container td:first-child {
      /*
    Set a small, fixed percentage for the first column.
    You can adjust this value (e.g., to 4%) to make it even thinner.
  */
      width: 20px;
      text-align: center;
    }
  </style>
</html>
