---
import Layout from "../layouts/HomeLayout.astro";
import Footer from "../components/Footer";
---

<Layout title="Awards - Lambert GA">
  <div class="w-full min-h-screen bg-[#FFFCF3] pt-24">
    <!-- Awards Content -->
    <section class="awards w-[60%] md:max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="hero w-full">
        <div class="flex items-center justify-center mb-8">
          <div class="text-center">
            <h1 class="text-4xl md:text-6xl font-bold text-green-800 mb-8">Grand Jamboree 2025</h1>
          </div>
        </div>
        
        <!-- Main Awards Row -->
        <div class="flex flex-wrap items-center justify-center gap-2 md:gap-8 mb-12">
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-32 h-32 md:w-40 md:h-40 object-contain mb-4" 
              src="https://static.igem.wiki/teams/5612/awards/softwaretool.avif" 
              alt="Best Software Award"
            />
            <h3 class="text-xl font-semibold text-green-800">Best Software</h3>
          </div>
          
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-32 h-32 md:w-40 md:h-40 object-contain mb-4" 
              src="https://static.igem.wiki/teams/5237/awards-page/group-91.svg" 
              alt="Gold Medal"
            />
            <h3 class="text-xl font-semibold text-green-800">Gold Medal</h3>
          </div>
          
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-32 h-32 md:w-40 md:h-40 object-contain mb-4" 
              src="https://static.igem.wiki/teams/5612/awards/top10.avif" 
              alt="Top 10"
            />
            <h3 class="text-xl font-semibold text-green-800">Top 10</h3>
          </div>
        </div>

        
        <!-- Nominations Section -->
        <h2 class="text-center text-green-700 text-3xl md:text-4xl font-bold mt-12 mb-8">Nominations</h2>
        
        <div class="w-full max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 justify-items-center mb-12">
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-20 h-20 md:w-24 md:h-24 object-contain mb-3" 
              src="https://static.igem.wiki/teams/5237/awards-page/best-model.svg" 
              alt="Best Modeling"
            />
            <h4 class="text-lg font-semibold text-green-800">Best Modeling</h4>
          </div>
          
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-20 h-20 md:w-24 md:h-24 object-contain mb-3" 
              src="https://static.igem.wiki/teams/5237/awards-page/best-education.svg" 
              alt="Best Education"
            />
            <h4 class="text-lg font-semibold text-green-800">Best Education</h4>
          </div>
          
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-20 h-20 md:w-24 md:h-24 object-contain mb-3" 
              src="https://static.igem.wiki/teams/5237/awards-page/best-wiki.svg" 
              alt="Best Wiki"
            />
            <h4 class="text-lg font-semibold text-green-800">Best Wiki</h4>
          </div>
          
          <div class="flex flex-col items-center justify-center text-center">
            <img 
              class="w-20 h-20 md:w-24 md:h-24 object-contain mb-3" 
              src="https://static.igem.wiki/teams/5237/awards-page/best-part.svg" 
              alt="Best Infectious Diseases"
            />
            <h4 class="text-lg font-semibold text-green-800">Best Infectious Diseases</h4>
          </div>
        </div>
      </div>
      

    </section>
    
    <!-- Footer -->
    <div class="mt-20">
      <Footer client:only="react" />
    </div>
  </div>
</Layout>