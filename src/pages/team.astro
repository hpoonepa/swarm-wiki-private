---
import Layout from "../layouts/HomeLayout.astro";
import Card from "../components/card.astro";
// import TeamMembers from "../components/TeamMembers";
import TeamMembers from "../components/teamMembers";
import Footer from "../components/Footer";
import LucideIcon, { PersonStandingIcon } from "lucide-react";
import clsx from "clsx";

let color = "magenta";
let descriptionTextColor: string;
descriptionTextColor =
  color == "blue"
    ? `text-blue-11`
    : color == "magenta"
      ? "text-magenta-11"
      : "text-pink-11";

let descriptionBGColor: string;
descriptionBGColor =
  color == "blue"
    ? `bg-blue-8/[0.25]`
    : color == "magenta"
      ? "bg-magenta-8/[0.25]"
      : "bg-pink-8/[0.25]";

let accentColor =
  color == "blue"
    ? `accent-blue-9`
    : color == "magenta"
      ? "accent-magenta-9"
      : "accent-pink-9";

let proseAAccent =
  color == "blue"
    ? `prose-a:text-blue-9`
    : color == "magenta"
      ? "prose-a:text-magenta-9"
      : "prose-a:text-pink-9";
---

<div>
  <Layout title="Team">
    <main class="teampage w-full text-center">
      <div class="clipboard-container flex flex-col justify-start pt-20 w-full items-center min-h-[100vh] space-y-6 mt-20 relative">
        <div class="relative w-full flex flex-col items-center">
          <div class="relative w-full flex flex-col items-center" style="min-height: 300px;">

            <!-- Uniform tint OVER the image -->
            <!-- CHANGED: class name + removed linear-gradient -->
            <div
              class="header-tint absolute top-[12%] left-1/2 w-screen h-full pointer-events-none"
            ></div>

            <!-- CHANGED: removed background:linear-gradient from style -->
            <img
              src="https://static.igem.wiki/teams/5612/teampage/teampageheader.webp"
              alt="Team background"
              class="absolute left-1/2  object-cover opacity-80 pointer-events-none select-none"
              style="z-index:1; width:100vw; min-width:100vw; max-width:100vw; transform:translateX(-50%); margin:0; padding:0;"
            />

            <div class="w-full flex flex-col items-center px-4 py-8 relative z-10" style="border-radius:1.5rem 1.5rem 0 0;">
              <!-- ...existing code... -->
              <h1
                class="font-inter font-bold text-4xl md:text-6xl lg:text-8xl text-center pt:[38vh] sm:pt-[40vh] md:pt-[42vh] lg:pt-[45vh]"
                style="color:#502F02;"
              >
                MEET THE TEAM
              </h1>
              <div class="subheading mt-4 mb-32 px-8 py-3 text-lg lg:text-2xl text-[#FFFFFF] bg-[#7a5a36] rounded-full shadow-lg inline-block">
                Lambert iGEM 2025
              </div>

            </div>
        </div>
        <div class="clipboard-img-wrapper relative flex justify-center items-start w-full" style="min-height:70vh;">
          <div class="clipboard-bg-cards relative w-full flex justify-center items-center" style="min-height:70vh;">
            <img src="https://static.igem.wiki/teams/5612/teampage/teamclipboard.webp" alt="Clipboard" class="clipboard-img w-auto max-w-[700px] h-auto mx-auto select-none pointer-events-none" style="display:block; position:relative; z-index:1;" />
            <div class="team-cards absolute top-[18%] left-1/2 transform -translate-x-1/2 w-[80%] max-w-[500px] flex flex-col items-center gap-6 z-10">
              <TeamMembers client:load />
            </div>
          </div>
        </div>
      </div>
    </main>
  </Layout>
  <Footer />
</div>
<style>
  body,
  html {
    width: 100%;
    height: 100%;
  }
  .team-symbol {
    width: 100px; /* Adjust the width as needed */
    height: auto;
    padding-bottom: 50px;
  }
  .teampage {
    width: 100%;
    /* background-color: rgba(245, 235, 219, 1); */
    padding: 0 1rem;
    margin: 0;
  }


  .clipboard-container {
    width: 100%;
    background: transparent;
    padding: 0 1rem;
    margin: 0;
    min-height: 100vh;
    position: relative;
  }

  .clipboard-bg-cards {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    min-height: 70vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: transparent;
  }

  .clipboard-img-wrapper {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
  }

  .clipboard-img {
    width: 300%;
    max-width: 4000px;
    height: auto;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  .team-cards {
    position: absolute;
    top: 14%; /* Move cards higher */
    left: 50%;
    transform: translateX(-50%);
    width: 1000%;
    max-width: 1000px;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-bottom: 5vh; /* Prevent overflow at the bottom */
    background: none;
    box-shadow: none;
    z-index: 2;
  }

  .header-background {
    background-image: url("https://static.igem.wiki/teams/5096/teampage/teampagebackground.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 2rem 1rem; /* Adjust the padding as needed */
  }

  .meetTheTeam {
    padding-bottom: 2rem;
  }

  .teamImg {
    position: relative;
    height: 312px;
  }

  .teamImg img {
    display: block;
    transition: opacity 0.3s ease;
  }

  .description {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(245, 235, 219, 1);
    color: rgba(245, 235, 219, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    overflow: auto;
  }

  .description.visible {
    opacity: 1;
    visibility: visible;
  }

  .bottom-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.75);
    color: white;
    padding: 1rem;
  }
</style>

<script></script>
