---
import './hardware.css';
const parts = [
  { id: 'chamber', name: 'Sample chamber', side: 'right' },
  { id: 'cup', name: 'Sample cup', side: 'left' },
  { id: 'platform', name: 'Raised platform', side: 'left' },
  { id: 'controls', name: 'Front-panel controls', side: 'left' },
  { id: 'enclosure', name: 'Main enclosure', side: 'right' },
  { id: 'board', name: 'Electronics board', side: 'left' },
  { id: 'unit', name: 'Internal unit', side: 'right' },
];
---
<section class="vapor-story" id="vapor-x" data-vapor-story aria-label="VAPOR-X exploded view">
  <header class="vapor-heading"><h2>VAPOR<span>-X</span></h2></header>
  <div class="vapor-track" data-vapor-track>
  <div class="vapor-stage" data-vapor-stage>
    <div class="vapor-workspace">
      <div class="vapor-render" data-vapor-render>
        <img class="vapor-loading-poster" src="https://static.igem.wiki/teams/6185/wiki/homepage/vapor-poster.webp" width="954" height="992" alt="Assembled VAPOR-X hardware" />
        <canvas data-vapor-canvas data-src="https://static.igem.wiki/teams/6185/wiki/homepage/vapor-exploded.webp" width="1186" height="1233" role="img" aria-label="Scroll to see VAPOR-X separate into its components, rotate, and come back together. Select a numbered part to inspect it."></canvas>
        <div class="vapor-hotspots" data-vapor-hotspots>
          {parts.map((part, i) => <button type="button" class="vapor-hotspot" data-part={part.id} aria-label={`Inspect ${part.name.toLowerCase()}`} aria-expanded="false" aria-controls={`vapor-detail-${part.id}`} style={`--x:50%;--y:50%`}><span>{i + 1}</span></button>)}
        </div>
      </div>
      {parts.map(part => <aside class="vapor-detail" data-vapor-detail={part.id} data-side={part.side} id={`vapor-detail-${part.id}`} aria-labelledby={`vapor-name-${part.id}`} hidden>
        <button type="button" data-vapor-close aria-label={`Close ${part.name.toLowerCase()} details`}>×</button>
        <h3 id={`vapor-name-${part.id}`}>{part.name}</h3>
      </aside>)}
      <p class="vapor-status" data-vapor-status></p>
    </div>
  </div>
  </div>
</section>
<script>
  import { initVaporExplorer } from './vapor-explorer';
  for (const story of document.querySelectorAll<HTMLElement>('[data-vapor-story]')) initVaporExplorer(story);
</script>
