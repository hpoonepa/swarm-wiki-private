  { id: 'controls', name: 'Front-panel controls', side: 'left', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.', note: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco.' },
