---
interface Props { title: string; phase?: string; shade?: number; }
const { title, phase, shade = 0 } = Astro.props;
const outlines = [
  'M61 4 H159 Q166 4 170 11 L214 88 Q220 98 214 108 L170 185 Q166 192 159 192 H61 Q54 192 50 185 L6 108 Q0 98 6 88 L50 11 Q54 4 61 4 Z',
  'M61 6 L158 3 Q166 3 170 12 L213 89 Q218 98 213 109 L169 184 Q165 191 157 192 L62 190 Q54 190 50 183 L7 108 Q2 98 7 88 L51 14 Q55 6 61 6 Z',
  'M63 4 L158 6 Q165 6 170 14 L214 89 Q219 98 213 108 L169 184 Q165 191 157 190 L61 193 Q54 193 50 184 L7 108 Q1 98 7 87 L51 11 Q55 4 63 4 Z',
];
const shape = outlines[Array.from(title).reduce((sum, character) => sum + character.charCodeAt(0), 0) % outlines.length];
---
<span class:list={['ihp-cell', `ihp-cell--${shade % 3}`, { 'ihp-cell--phase': !!phase }]}>
  <svg class="ihp-cell__shape" viewBox="0 0 220 198" aria-hidden="true">
    <path class="ihp-cell__face" d={shape} />
    <path class="ihp-cell__inner" d="M66 15 H154 Q161 15 165 22 L205 91 Q209 98 205 105 L165 174 Q161 181 154 181 H66 Q59 181 55 174 L15 105 Q11 98 15 91 L55 22 Q59 15 66 15 Z" />
  </svg>
  <span class="ihp-cell__words">
    {phase ? <><span class="ihp-cell__phase-label">Phase</span><strong class="ihp-cell__phase-number">{Number(phase)}</strong></> : <strong class="ihp-cell__title">{title.split(' ').map(word => <span>{word}</span>)}</strong>}
  </span>
</span>
