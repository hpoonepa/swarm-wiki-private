---
// src/components/Section.astro
---
<section>
  <slot />
</section>

<style>
  section {
    background-color: #FFFCF3; 
    padding: 1.5rem;
    border-radius: 20px; /* Rounded corners for each box */
    box-shadow: 0px 15px 5px -10px #00000020; /* The shadow for each box */
    margin-bottom: 40px;
  }

  section > :global(h2) {
    background-color: #cfe6b2;
    text-align: center;
    font-size: 20px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom: 4px solid #447700;
    border-radius: 20px 20px 0px 0px;
    margin-top: -1.5rem; /* Pulls the heading up to the top edge */
    margin-inline: -1.5rem; /* Stretches the heading to the side edges */
    margin-bottom: 1.5rem;
  }

  

  
</style>