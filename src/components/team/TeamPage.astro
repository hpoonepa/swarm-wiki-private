---
// Team page = 1:1 embed of the reference design (static/teampage/hive.svg,
// the full 1440x4345 "Our Hive" artboard). The site renders its own fixed nav
// on top; this export contains no nav of its own, so it drops in cleanly.
const HIVE_SVG_URL = "/lambert-ga/teampage/hive.svg";
---

<main class="w-screen overflow-hidden bg-[#EFFCFF]">
  <img
    src={HIVE_SVG_URL}
    alt="Our Hive — the SWARM team"
    class="block w-full select-none"
    style="aspect-ratio:1440/4345;"
  />
</main>
