---
import { members, advisors, externalAdvisors, memberDetails } from './team-data';
import Portrait from './Portrait.astro';
import './team.css';
const advisorGroups = [
  { id: 'advisors', title: 'Team Advisor', members: advisors, primary: true },
  { id: 'external-advisors', title: 'External Advisors', members: externalAdvisors, primary: false },
];
---
<div class="team-directory wide" id="team-main">
  <section class="team-roster" id="the-team" aria-labelledby="students-title">
    <div class="team-section-heading">
      <h2 id="students-title">Students</h2>
    </div>
    <div class="team-grid" data-team-grid>
      {members.map((member, index) => <article class="team-member" data-member={member.id}>
        <Portrait photo={member.photo} name={member.name} eager={index < 5} />
        <div class="team-member__caption">
          <h3>{member.name}</h3>
          {memberDetails(member) && <p class="team-member__details">{memberDetails(member)}</p>}
          {member.bio && <>
            <details class="team-bio-fallback" data-bio-fallback>
              <summary>About {member.name.split(' ')[0]}</summary>
              <div data-member-bio><p>{member.bio}</p></div>
            </details>
          </>}
        </div>
        <button type="button" class="team-member__open" data-member-open={member.id} data-member-name={member.name} data-member-details={memberDetails(member)} aria-controls="team-profile" aria-haspopup="dialog" aria-expanded="false" aria-label={`View ${member.name}'s profile`} hidden><span class="team-member__control-frame" aria-hidden="true"><span>+</span></span></button>
      </article>)}
    </div>
  </section>
  {advisorGroups.map(group => <section class:list={["team-advisors", { "team-advisors--primary": group.primary }]} id={group.id} aria-labelledby={`${group.id}-title`}>
    <div class="team-advisors__content">
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <div class="team-advisor-grid">
        {group.members.map(member => <article class="team-advisor" data-member={member.id}>
          <Portrait photo={member.photo} name={member.name} />
          <div class="team-advisor__copy">
            <h3>{member.name}</h3>
            {member.affiliation && <p class="team-advisor__affiliation">{member.affiliation}</p>}
            {member.bio && <p class="team-advisor__bio" data-member-bio>{member.bio}</p>}
            {member.profileUrl && <a class="team-advisor__link" href={member.profileUrl}>University profile<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4h9v9M16 4 5 15" /></svg></a>}
          </div>
          <button type="button" class="team-member__open team-advisor__open" data-member-open={member.id} data-member-name={member.name} data-member-details={member.affiliation} aria-controls="team-profile" aria-haspopup="dialog" aria-expanded="false" aria-label={`View ${member.name}'s profile`} hidden><span class="team-advisor__open-icon" aria-hidden="true">+</span></button>
        </article>)}
      </div>
    </div>
  </section>)}
  <dialog class="team-profile" id="team-profile" data-team-profile aria-labelledby="team-profile-name">
    <div class="team-profile__sheet" data-profile-sheet>
      <div class="team-profile__toolbar">
        <span class="team-profile__position" data-profile-position></span>
        <button type="button" class="team-profile__close" data-profile-close aria-label="Close profile" autofocus><span>Close</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg></button>
      </div>
      <div class="team-profile__content">
        <div class="team-profile__portrait" data-profile-portrait></div>
        <div class="team-profile__copy">
          <div class="team-profile__heading"><h2 id="team-profile-name" data-profile-name></h2><p data-profile-details></p></div>
          <div class="team-profile__bio" data-profile-bio></div>
          <div class="team-profile__links" data-profile-links></div>
        </div>
      </div>
      <nav class="team-profile__navigation" aria-label="Browse team profiles">
        <button type="button" data-profile-previous><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m7-7-7 7 7 7" /></svg><span>Previous</span></button>
        <button type="button" data-profile-next><span>Next</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7" /></svg></button>
      </nav>
      <span class="team-profile__announcement" data-profile-announcement role="status" aria-atomic="true"></span>
    </div>
  </dialog>
</div>
<script>
  import { initTeam } from './team';
  initTeam();
</script>
