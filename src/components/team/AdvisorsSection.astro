---
import AdvisorCard from "./AdvisorCard.astro";

interface Advisor {
  name: string;
  role: string;
  photo: string;
  frame: "gold" | "purple" | "blue";
}

interface Props {
  advisors: Advisor[];
  backgroundSrc: string;
  frameMap: Record<Advisor["frame"], string>;
}

const { advisors, backgroundSrc, frameMap } = Astro.props;

const advisorCardClasses = [
  "w-[clamp(12rem,19vw,20rem)] max-[720px]:w-[min(16rem,86vw)]",
  "w-[clamp(12rem,19vw,20rem)] translate-y-[4.8rem] max-[720px]:w-[min(16rem,86vw)] max-[720px]:translate-y-0",
  "w-[clamp(12rem,19vw,20rem)] translate-y-[1.7rem] max-[720px]:w-[min(16rem,86vw)] max-[720px]:translate-y-0",
];
---

<section
  class="relative isolate mx-auto mt-[clamp(4rem,9vw,7rem)] mb-[clamp(5rem,10vw,10rem)] w-screen min-h-[clamp(46rem,68vw,72rem)] pt-[clamp(9rem,11vw,10rem)] pb-[clamp(9rem,14vw,15rem)] before:content-[''] before:absolute before:top-[clamp(0rem,2vw,1.5rem)] before:inset-x-0 before:bottom-0 before:z-0 before:pointer-events-none max-[720px]:mb-24 max-[720px]:min-h-[56rem] max-[720px]:px-[1.1rem] max-[720px]:pt-[4.5rem] max-[720px]:pb-32 max-[720px]:before:top-16"
  aria-labelledby="advisors-title"
>
  <img
    src={backgroundSrc}
    alt=""
    aria-hidden="true"
    class="absolute top-[-5rem] left-1/2 z-[1] h-[calc(100%-clamp(0rem,2vw,1.5rem))] w-screen max-w-none origin-top object-fill pointer-events-none select-none [--blob-scale:1.3] -translate-x-1/2 scale-[var(--blob-scale)] max-[720px]:top-16 max-[720px]:h-[calc(100%-4rem)] max-[720px]:[--blob-scale:1.08]"
  />

  <div class="relative z-[3] grid justify-items-center gap-[clamp(2.3rem,5vw,4rem)]">
    <h2 id="advisors-title" class="m-0 text-[#de6263] text-[clamp(2.8rem,7vw,4.8rem)] font-[850] leading-none tracking-normal">Advisors</h2>
    <div class="flex w-[min(92vw,86rem)] items-end justify-center gap-[clamp(1.8rem,7vw,8rem)] max-[720px]:grid max-[720px]:w-[min(100%,21rem)] max-[720px]:justify-items-center max-[720px]:gap-[2.2rem]">
      {advisors.map((advisor, index) => (
        <AdvisorCard
          name={advisor.name}
          role={advisor.role}
          photo={advisor.photo}
          frameSrc={frameMap[advisor.frame]}
          class={advisorCardClasses[index] ?? advisorCardClasses[0]}
        />
      ))}
    </div>
  </div>
</section>
