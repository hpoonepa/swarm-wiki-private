---
import ProfileImageFrame from "./ProfileImageFrame.astro";

interface Props {
  name: string;
  role: string;
  photo: string;
  frameSrc: string;
}

const { name, role, photo, frameSrc } = Astro.props;
---

<article class="relative z-[1] grid min-w-0 justify-items-center gap-[0.15rem] text-center">
  <ProfileImageFrame src={photo} alt={name} shape="hex" frameSrc={frameSrc} />
  <div class="mt-[-0.72rem] grid justify-items-center gap-[0.05rem] text-[#0b0b0b] leading-none">
    <h3 class="m-0 max-w-full break-words text-[clamp(0.64rem,1.2vw,0.82rem)] font-extrabold">{name}</h3>
    <p class="m-0 max-w-full break-words text-[clamp(0.48rem,0.95vw,0.62rem)] font-bold">{role}</p>
  </div>
</article>
