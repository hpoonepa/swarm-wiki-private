---
interface Props { photo?: string; name: string }
const { photo, name } = Astro.props;
const initials = name.split(' ').map(part => part[0]).slice(0, 2).join('');
---
<span class="hive-portrait" aria-hidden="true">
  <span class="hive-portrait__border"><span class="hive-portrait__surface">
    {photo ? <img src={photo} alt="" width="360" height="540" loading="lazy" decoding="async" /> : <span class="hive-portrait__initials">{initials}</span>}
  </span></span>
</span>
