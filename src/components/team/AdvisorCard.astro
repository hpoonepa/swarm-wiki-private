---
import ProfileImageFrame from "./ProfileImageFrame.astro";

interface Props {
  name: string;
  role: string;
  photo: string;
  frameSrc: string;
  class?: string;
}

const { name, role, photo, frameSrc, class: className = "" } = Astro.props;
---

<article class:list={["relative z-[1] grid min-w-0 justify-items-center gap-[0.45rem] text-center", className]}>
  <ProfileImageFrame src={photo} alt={name} shape="circle" frameSrc={frameSrc} />
  <div class="grid gap-[0.12rem] text-[#030303] leading-none">
    <h3 class="m-0 max-w-full break-words text-[clamp(0.9rem,1.45vw,1.1rem)] font-extrabold">{name}</h3>
    <p class="m-0 max-w-full break-words text-[clamp(0.64rem,1vw,0.78rem)] font-bold">{role}</p>
  </div>
</article>
