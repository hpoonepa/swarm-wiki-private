---
import './honeycomb.css';

export type HoneycombCorner = 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
interface Props { title: string; summary?: string; corner?: HoneycombCorner }
const { title, summary, corner = 'top-right' } = Astro.props;

const ART_W = 720;
const ART_H = 900;
const R = 40;
const R_DRAW = 36.5;
const HEX_W = Math.sqrt(3) * R;
const ROW_H = 1.5 * R;
const REACH_X = 660;
const REACH_Y = 880;
const TAPER = 0.55;
const seed = { x: ART_W - HEX_W / 2, y: R };

function noise(a: number, b: number, salt: number): number {
  let h = (Math.imul(a, 374761393) + Math.imul(b, 668265263) + Math.imul(salt, 2246822519)) | 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}

function ring(c: number, r: number): number {
  const q = c - (r - (r & 1)) / 2;
  return Math.max(Math.abs(q), Math.abs(r), Math.abs(q + r));
}

function hexPoints(cx: number, cy: number, radius: number): string {
  const points: string[] = [];
  for (let k = 0; k < 6; k++) {
    const a = (Math.PI / 180) * (60 * k + 30);
    points.push(`${(cx + radius * Math.cos(a)).toFixed(2)},${(cy + radius * Math.sin(a)).toFixed(2)}`);
  }
  return points.join(' ');
}

interface Cell { points: string; opacity: number; outline: boolean; delay: number }
const cells: Cell[] = [];
for (let r = 0; ; r++) {
  const cy = R + r * ROW_H;
  if (cy - R_DRAW > ART_H) break;
  for (let c = 0; ; c++) {
    const cx = ART_W - HEX_W / 2 - c * HEX_W - (r & 1) * (HEX_W / 2);
    if (cx + R_DRAW < 0) break;
    const dy = (cy - seed.y) / REACH_Y;
    const dx = (seed.x - cx) / (REACH_X * (1 - TAPER * Math.min(1, dy)));
    const t = Math.sqrt(dx * dx + dy * dy);
    if (t > 1) continue;
    if (noise(c, r, 1) < Math.max(0, (t - 0.7) / 0.3) * 0.92) continue;
    const base = 1 - 0.7 * Math.pow(t, 1.25);
    const grain = 0.82 + 0.36 * noise(c, r, 2);
    const opacity = Math.min(1, Math.max(0.16, base * grain));
    const outline = t > 0.5 && noise(c, r, 3) < 0.2;
    const delay = 0.05 + ring(c, r) * 0.045 + r * 0.03 + noise(c, r, 4) * 0.08;
    cells.push({ points: hexPoints(cx, cy, R_DRAW), opacity: +opacity.toFixed(3), outline, delay: +delay.toFixed(3) });
  }
}
---
<header class="honeycomb-window" data-honeycomb-window>
  <div class="honeycomb-window__comb" data-corner={corner} aria-hidden="true">
    <svg viewBox={`0 0 ${ART_W} ${ART_H}`} preserveAspectRatio="xMaxYMin meet" focusable="false">
      <defs>
        <linearGradient id="hc-gold" gradientUnits="userSpaceOnUse" x1={seed.x} y1={seed.y} x2={ART_W * 0.2} y2={ART_H}>
          <stop offset="0" class="hc-stop-honey" />
          <stop offset="0.45" class="hc-stop-deep" />
          <stop offset="1" class="hc-stop-orange" />
        </linearGradient>
      </defs>
      <g class="hc-cluster" style={`transform-origin:${seed.x}px ${seed.y}px`}>
        {cells.map(cell => cell.outline
          ? <polygon class="hc-cell hc-cell--wall" points={cell.points} style={`--hc-delay:${cell.delay}s`} stroke-opacity={Math.min(1, cell.opacity + 0.2)} />
          : <polygon class="hc-cell" points={cell.points} style={`--hc-delay:${cell.delay}s`} fill-opacity={cell.opacity} />)}
      </g>
    </svg>
  </div>
  <div class="honeycomb-window__text">
    <div class="honeycomb-window__inner">
      <h1 class="display-l honeycomb-window__title">{title}</h1>
      {summary && <div class="honeycomb-window__cell"><div class="honeycomb-window__cell-inner"><p class="honeycomb-window__summary">{summary}</p></div></div>}
    </div>
  </div>
</header>
